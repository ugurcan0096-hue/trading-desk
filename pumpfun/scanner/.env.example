# Copy to .env and fill in. .env is git-ignored. NEVER put a seed phrase or private key here.
HELIUS_API_KEY=
# or any Solana RPC URL instead of Helius:
SOLANA_RPC_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rules (defaults shown)
MAX_TOP10_PCT=25
MAX_DEV_PCT=5
MAX_BLOCK0_BUYERS=3
MIN_CURVE_PCT=15
MAX_CURVE_PCT=80
MAX_AGE_HOURS=6

# No alerts from 01:00 to 08:00 local time ("no trades after 1 AM"). Leave empty to disable.
QUIET_START_HOUR=1
QUIET_END_HOUR=8

POLL_SECONDS=15
# Keep re-checking tokens below MIN_CURVE_PCT for this long before giving up
WATCH_MINUTES=30
WATCH_MAX=40
PUMPFUN_API=https://frontend-api-v3.pump.fun
